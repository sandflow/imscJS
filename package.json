{
    "name": "imsc",
    "description": "Renders IMSC documents to HTML5 fragments",
    "version": "1.1.5",
    "license": "BSD-2-Clause",
    "homepage": "https://github.com/sandflow/imscJS",
    "bugs": "https://github.com/sandflow/imscJS/issues",
    "repository": "github:sandflow/imscJS",
    "type": "module",
    "files": [
        "src/main/js",
        "README.txt",
        "dist"
    ],
    "keywords": [
        "imsc1",
        "imsc1.0.1",
        "imsc",
        "imsc1.1",
        "ebut-tt-d",
        "smpte-tt",
        "sdp-us",
        "cff-tt",
        "ttml",
        "imsc"
    ],
    "author": "Pierre-Anthony Lemieux <pal@sandflow.com>",
    "main": "dist/main/js/main.js",
    "types": "dist/main/js/main.d.ts",
    "unpkg": "dist/imsc.min.js",
    "scripts": {
        "prepublishOnly": "npm run build:release",
        "dev": "npx http-server build/public_html",
        "lint": "eslint .",
        "fix": "eslint --fix src",
        "build": "npm run build:debug",
        "build:debug": "npm run lint && tsc && rollup -c rollup.config.js && node scripts/build.js webapp:debug",
        "build:release": "npm run lint && tsc && rollup -c rollup.config.js && node scripts/build.js webapp:release",
        "clean": "node scripts/build.js clean",
        "test": "node --test ./src/test/js/*Test.js"
    },
    "dependencies": {
        "sax": "^1.6.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@types/sax": "^1.2.7",
        "eslint": "^9.39.5",
        "filesaver.js-npm": "latest",
        "globals": "^17.11.0",
        "jszip": "latest",
        "rollup": "^4.14.3",
        "rollup-plugin-polyfill-node": "^0.13.0",
        "tslib": "^2.6.2",
        "typescript": "^5.4.5"
    }
}
